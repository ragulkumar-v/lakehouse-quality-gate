# --- Python ---
.venv/
.venv-data/
.venv-airflow/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
coverage.xml
htmlcov/

# --- dbt ---
# NOTE: "target/" here anchors to any directory literally named "target"
# (dbt_project/target, and any future dbt project's target dir) -- there is
# no source directory in this repo named "target", so this is safe.
target/
dbt_packages/
dbt_project/logs/
dbt_project/.user.yml

# --- Great Expectations / Airflow runtime ---
.airflow_home/
logs/
gx/uncommitted/

# --- Generated data / warehouse artifacts ---
# Everything the pipeline *produces* at runtime: the DuckDB warehouse file,
# the Iceberg catalog + lake (real Parquet/Avro/JSON files regenerated by
# `ingestion/land_raw_data.py` on every run), manifests, and webhook alert
# payloads. Only the small, hand-authored CSV fixtures under fixtures/ are
# committed -- those are inputs, not outputs, and stay tiny (~100KB).
*.duckdb
*.duckdb.wal
data/lake/
data/iceberg_catalog.db
data/manifests/
data/alerts/
data/great_expectations/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- OS / editor cruft ---
.DS_Store
*.swp
.vscode/
.idea/
